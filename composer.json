{
    "name": "emanate/kitasa",
    "description": "This is my package kitasa",
    "keywords": [
        "emanate",
        "laravel",
        "kitasa"
    ],
    "homepage": "https://github.com/emanate/kitasa",
    "license": "MIT",
    "authors": [
        {
            "name": "Emanate Software",
            "email": "hello@emanate.software",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8"
    },
    "autoload": {
        "psr-4": {
            "Emanate\\Kitasa\\": "src/",
            "Emanate\\Kitasa\\Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emanate\\Kitasa\\KitasaServiceProvider"
            ],
            "aliases": {
                "Kitasa": "Emanate\\Kitasa\\Facades\\Kitasa"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
